<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.icesi.sgmms.controller.IncidentPanelController" styleClass="screen">
    <top>
        <VBox spacing="12" styleClass="screen-header">
            <VBox spacing="2">
                <Label text="Panel de Incidentes" styleClass="screen-title"/>
                <Label text="Registrar, consultar y atender los incidentes activos" styleClass="screen-subtitle"/>
            </VBox>
            <HBox spacing="12">
                <VBox spacing="4" styleClass="summary-card, urgent-card" HBox.hgrow="ALWAYS">
                    <Label text="MAYOR PRIORIDAD PENDIENTE" styleClass="summary-caption"/>
                    <Label fx:id="mostUrgentLabel" styleClass="summary-value" wrapText="true"/>
                </VBox>
                <VBox spacing="4" styleClass="summary-card" HBox.hgrow="ALWAYS">
                    <Label text="SIGUIENTE EN LA COLA DE DESPACHO" styleClass="summary-caption"/>
                    <Label fx:id="nextInQueueLabel" styleClass="summary-value" wrapText="true"/>
                </VBox>
                <VBox spacing="4" styleClass="summary-card" HBox.hgrow="ALWAYS">
                    <Label text="ÚLTIMA ACCIÓN" styleClass="summary-caption"/>
                    <Label fx:id="lastActionLabel" styleClass="summary-value" wrapText="true"/>
                </VBox>
            </HBox>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.6" styleClass="panel-split">
            <VBox spacing="10" styleClass="panel-left">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="Consultar por ID (ej. INC-0003)" onAction="#search" prefWidth="230"/>
                    <Button text="Consultar" onAction="#search" styleClass="secondary-button"/>
                    <ComboBox fx:id="severityFilter" prefWidth="190"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Button text="Atender siguiente" onAction="#attendNext" styleClass="primary-button"/>
                </HBox>
                <TableView fx:id="incidentTable" VBox.vgrow="ALWAYS" minHeight="220">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="78"/>
                        <TableColumn fx:id="typeColumn" text="Tipo" prefWidth="80"/>
                        <TableColumn fx:id="locationColumn" text="Ubicación" prefWidth="74"/>
                        <TableColumn fx:id="severityColumn" text="Gravedad" prefWidth="80"/>
                        <TableColumn fx:id="statusColumn" text="Estado" prefWidth="86"/>
                        <TableColumn fx:id="vehicleColumn" text="Vehículo" prefWidth="68"/>
                        <TableColumn fx:id="createdColumn" text="Generado" prefWidth="132"/>
                        <TableColumn fx:id="elapsedColumn" text="Espera" prefWidth="62"/>
                    </columns>
                </TableView>
                <TabPane tabClosingPolicy="UNAVAILABLE" prefHeight="230" minHeight="180">
                    <Tab text="Vehículos">
                        <VBox spacing="6">
                            <TableView fx:id="vehicleTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="vIdColumn" text="ID" prefWidth="70"/>
                                    <TableColumn fx:id="vTypeColumn" text="Tipo" prefWidth="140"/>
                                    <TableColumn fx:id="vLocationColumn" text="Ubicación" prefWidth="80"/>
                                    <TableColumn fx:id="vStatusColumn" text="Estado" prefWidth="110"/>
                                    <TableColumn fx:id="vIncidentColumn" text="Incidente" prefWidth="90"/>
                                </columns>
                            </TableView>
                            <Button text="Poner fuera de servicio / devolver al servicio" onAction="#toggleOutOfService"
                                    styleClass="secondary-button"/>
                        </VBox>
                    </Tab>
                    <Tab text="Resueltos">
                        <TableView fx:id="resolvedTable">
                            <columns>
                                <TableColumn fx:id="rIdColumn" text="ID" prefWidth="80"/>
                                <TableColumn fx:id="rTypeColumn" text="Tipo" prefWidth="100"/>
                                <TableColumn fx:id="rSeverityColumn" text="Gravedad" prefWidth="80"/>
                                <TableColumn fx:id="rMinutesColumn" text="Tiempo de atención" prefWidth="130"/>
                                <TableColumn fx:id="rVehicleColumn" text="Vehículo" prefWidth="80"/>
                            </columns>
                        </TableView>
                    </Tab>
                    <Tab text="Historial de acciones">
                        <ListView fx:id="actionList"/>
                    </Tab>
                </TabPane>
            </VBox>
            <ScrollPane fitToWidth="true" styleClass="side-scroll">
                <VBox spacing="12" styleClass="side-panel">
                    <VBox spacing="8" styleClass="card">
                        <Label fx:id="detailTitle" styleClass="card-title"/>
                        <Label fx:id="detailBody" styleClass="field-value" wrapText="true"/>
                        <Label fx:id="suggestionLabel" styleClass="suggestion" wrapText="true"/>
                        <ComboBox fx:id="vehicleChoice" maxWidth="Infinity" promptText="Vehículo compatible y disponible"/>
                        <HBox spacing="8">
                            <Button fx:id="assignButton" text="Asignar vehículo" onAction="#assignSelected" styleClass="primary-button"/>
                            <Button fx:id="assignSuggestedButton" text="Asignar el sugerido" onAction="#assignSuggested" styleClass="secondary-button"/>
                        </HBox>
                        <Button fx:id="resolveButton" text="Resolver incidente" onAction="#resolve" styleClass="success-button" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="8" styleClass="card">
                        <Label text="Registrar incidente" styleClass="card-title"/>
                        <GridPane hgap="8" vgap="8">
                            <Label text="Tipo" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="newType" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity"/>
                            <Label text="Gravedad" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="newSeverity" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity"/>
                            <Label text="Ubicación" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <HBox spacing="6" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <TextField fx:id="newX" promptText="X" prefWidth="55"/>
                                <TextField fx:id="newY" promptText="Y" prefWidth="55"/>
                                <Button text="Posición del operador" onAction="#useOperatorPosition" styleClass="link-button"/>
                            </HBox>
                            <Label text="Descripción" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <TextField fx:id="newDescription" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="Opcional"/>
                        </GridPane>
                        <Button text="Registrar incidente" onAction="#registerIncident" styleClass="secondary-button" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="8" styleClass="card">
                        <Label text="Registrar vehículo" styleClass="card-title"/>
                        <GridPane hgap="8" vgap="8">
                            <Label text="ID" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="vehicleIdField" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="ej. P-05"/>
                            <Label text="Tipo" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="vehicleTypeBox" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity"/>
                            <Label text="Ubicación" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <HBox spacing="6" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <TextField fx:id="vehicleX" promptText="X" prefWidth="55"/>
                                <TextField fx:id="vehicleY" promptText="Y" prefWidth="55"/>
                            </HBox>
                        </GridPane>
                        <Button text="Registrar vehículo" onAction="#registerVehicle" styleClass="secondary-button" maxWidth="Infinity"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>
</BorderPane>
